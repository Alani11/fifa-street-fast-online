+    /// <summary>"Automatic" GPU choice: the hardware adapter with the most dedicated video memory (the discrete GPU on a
+    /// laptop). Without this the engine takes the first adapter, which is the integrated GPU on hybrid-graphics PCs.
+    /// Returns -1 (let the engine decide) when there is zero or one hardware adapter or the query fails.</summary>
+    internal static int PreferredHardwareAdapter()
+    {
+        try
+        {
+            var all = Enumerate();
+            if (all.Count < 2)
+                return -1;
+            Adapter best = all[0];
+            foreach (var adapter in all)
+                if (adapter.DedicatedMemory > best.DedicatedMemory)
+                    best = adapter;
+            return checked((int)best.Index);
+        }
+        catch (Exception)
+        {
+            return -1;
+        }
+    }
 
